# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Your Totalum VCaaS API key. This is the ONLY variable that must be set for
# the app to work. Get it from your Totalum account (VCaaS section).
VCAAS_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by the middleware to allow-list the origin
# for CSP/CORS in production. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
